@page "/login"
@using System.Net.Http.Json
@using Frontend.Services
@inject HttpClient Http
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<div class="auth-page" style="background-image: linear-gradient(135deg, rgba(15,23,42,0.75), rgba(15,23,42,0.55)), url('images/auth-bg.jpg'); background-size: cover; background-position: center;">
    <div class="glass-card p-4 p-md-5" style="max-width: 420px; width: 100%;">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-white">@Loc.T("login_title")</h3>
            <p class="text-white-50 small">@Loc.T("login_subtitle")</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 small">
                @errorMessage
                @if (showResendOption)
                {
                    <div class="mt-2">
                        <button type="button" class="btn btn-sm btn-outline-danger" disabled="@isResending" @onclick="HandleResend">
                            @(isResending ? "Sending..." : "Resend verification email")
                        </button>
                    </div>
                }
            </div>
        }
        @if (!string.IsNullOrEmpty(resendMessage))
        {
            <div class="alert alert-success py-2 small">@resendMessage</div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label fw-semibold text-white">@Loc.T("lbl_email")</label>
                <InputText @bind-Value="loginModel.Email" class="form-control glass-input" />
                <ValidationMessage For="@(() => loginModel.Email)" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-white">@Loc.T("lbl_password")</label>
                <InputText @bind-Value="loginModel.Password" type="password" class="form-control glass-input" />
                <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small" />
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <InputCheckbox @bind-Value="loginModel.RememberMe" class="form-check-input" id="rememberMe" />
                    <label class="form-check-label small text-white-50" for="rememberMe">@Loc.T("remember_me")</label>
                </div>
                <a href="forgot-password" class="text-white fw-bold text-decoration-none small">@Loc.T("forgot_password")</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold py-2 hover-lift" disabled="@isSubmitting">
                @(isSubmitting ? Loc.T("btn_signing_in") : Loc.T("btn_signin"))
            </button>
        </EditForm>

        <div class="text-center mt-4">
            <span class="text-white-50 small">@Loc.T("msg_no_account") </span>
            <a href="register" class="text-white fw-bold text-decoration-none small">@Loc.T("link_create_account")</a>
        </div>
    </div>
</div>
@code {
    private LoginModel loginModel = new LoginModel();
    private string? errorMessage;
    private string? resendMessage;
    private bool showResendOption = false;
    private bool isSubmitting = false;
    private bool isResending = false;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    private async Task HandleLogin()
    {
        errorMessage = null;
        resendMessage = null;
        showResendOption = false;
        isSubmitting = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", new
            {
                email = loginModel.Email,
                password = loginModel.Password
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResult>();
                if (result is not null)
                {
                    await AuthState.SetUserAsync(result.UserId, result.FullName, result.Email, result.Role, result.Token);
                    var destination = result.Role switch
                    {
                        "Admin" => "admin",
                        "Employer" => "employer",
                        _ => "worker"
                    };
                    Navigation.NavigateTo(destination);
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                errorMessage = "Please verify your email address before logging in. Check your inbox for the verification link.";
                showResendOption = true;
            }
            else
            {
                errorMessage = Loc.T("err_invalid_credentials");
            }
        }
        catch (Exception)
        {
            errorMessage = Loc.T("err_server_unreachable");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }

    private async Task HandleResend()
    {
        isResending = true;
        resendMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/resend-verification", new { email = loginModel.Email });
            resendMessage = response.IsSuccessStatusCode
                ? "If an account with that email needs verifying, a new link has been sent."
                : "Could not resend the verification email. Please try again.";
        }
        catch (Exception)
        {
            resendMessage = "Could not reach the server. Please try again.";
        }
        finally
        {
            isResending = false;
        }
    }

    public class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; } = false;
    }

    private class LoginResult
    {
        public int UserId { get; set; }
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
        public string Token { get; set; } = "";
    }
}
