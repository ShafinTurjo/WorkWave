@page "/employer"
@using System.Net.Http.Json
@using Frontend.Services
@inject HttpClient Http
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@inject LocalizationService Loc
@implements IDisposable

<div class="container mt-4 mb-5">
    @if (!authorized)
    {
        <div class="alert alert-warning">@Loc.T("checking_access")</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1 text-white">@Loc.T("employer_dashboard_title")</h3>
                <p class="text-white-50 mb-0">@Loc.T("welcome_back") @AuthState.FullName</p>
            </div>
            <a href="post-job" class="btn btn-primary px-4 rounded-pill fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> @Loc.T("post_new_job")
            </a>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 small mb-4">@errorMessage</div>
        }

        <!-- Top Metrics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small fw-medium">@Loc.T("total_jobs")</span>
                    <h3 class="fw-bold text-primary mt-2 mb-0">@(stats?.TotalJobs ?? 0)</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small fw-medium">@Loc.T("total_applicants")</span>
                    <h3 class="fw-bold text-success mt-2 mb-0">@(stats?.TotalApplicants ?? 0)</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small fw-medium">@Loc.T("active_listings")</span>
                    <h3 class="fw-bold text-warning mt-2 mb-0">@(stats?.ActiveJobs ?? 0)</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small fw-medium">@Loc.T("closed_listings")</span>
                    <h3 class="fw-bold text-secondary mt-2 mb-0">@(stats?.ClosedJobs ?? 0)</h3>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white fw-bold py-3 border-0">@Loc.T("my_posted_jobs")</div>
            <div class="card-body p-4">
                @if (loading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                }
                else if (jobs.Count == 0)
                {
                    <p class="text-muted mb-0">@Loc.T("no_jobs_posted")</p>
                }
                else
                {
                    @foreach (var job in jobs)
                    {
                        <div class="border rounded-4 p-3 mb-3 bg-white shadow-sm">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h5 class="fw-bold mb-0">@job.Title</h5>
                                        @if (job.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill">
                                                <i class="bi bi-x-circle-fill me-1"></i> @Loc.T("status_rejected")
                                            </span>
                                        }
                                        else if (job.IsFlagged)
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill">
                                                <i class="bi bi-exclamation-triangle-fill me-1"></i> @Loc.T("under_review")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge @(job.IsActive ? "bg-success-subtle text-success border border-success-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle") rounded-pill">
                                                @(job.IsActive ? Loc.T("status_active") : Loc.T("status_closed"))
                                            </span>
                                        }
                                    </div>
                                    <p class="text-muted small mb-1">@job.Company · @job.Location · @job.JobType</p>
                                    <p class="text-muted small mb-0">@Loc.T("posted_on") @job.PostedAt.ToLocalTime().ToString("dd MMM yyyy")</p>

                                    @if (job.Status == "Rejected" && !string.IsNullOrEmpty(job.RejectionReason))
                                    {
                                        <p class="text-danger small mt-1 mb-0"><strong>@Loc.T("reason_label")</strong> @job.RejectionReason</p>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    @if (job.IsFlagged)
                                    {
                                        <span class="text-muted small align-self-center fst-italic me-2">@Loc.T("pending_admin_review")</span>
                                    }
                                    else if (job.Status != "Rejected")
                                    {
                                        <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="() => ToggleApplicants(job.Id)">
                                            @(expandedJobId == job.Id ? Loc.T("hide_applicants") : Loc.T("view_applicants"))
                                        </button>

                                        <button class="btn btn-sm @(job.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-3" @onclick="() => ToggleJobStatus(job)">
                                            @(job.IsActive ? Loc.T("close_job") : Loc.T("reopen_job"))
                                        </button>
                                    }

                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => DeleteJob(job.Id)">
                                        @Loc.T("delete")
                                    </button>
                                </div>
                            </div>

                            @if (expandedJobId == job.Id)
                            {
                                <hr />
                                @if (loadingApplicants)
                                {
                                    <p class="text-muted small mb-0">@Loc.T("loading_applicants")</p>
                                }
                                else if (applicants.Count == 0)
                                {
                                    <p class="text-muted small mb-0">@Loc.T("no_applicants_yet")</p>
                                }
                                else
                                {
                                    <table class="table table-sm mb-0 align-middle mt-2">
                                        <thead>
                                            <tr><th>@Loc.T("th_name")</th><th>@Loc.T("th_email")</th><th>@Loc.T("th_applied")</th><th>@Loc.T("th_resume")</th><th>@Loc.T("th_status")</th><th>@Loc.T("th_action")</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var a in applicants)
                                            {
                                                <tr>
                                                    <td>@a.ApplicantName</td>
                                                    <td>@a.ApplicantEmail</td>
                                                    <td>@a.AppliedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(a.ResumeUrl))
                                                        {
                                                            <a class="btn btn-sm btn-outline-primary rounded-pill px-2" href="@a.ResumeUrl" target="_blank" rel="noopener">
                                                                <i class="bi bi-file-earmark-pdf-fill me-1"></i>@Loc.T("view_cv")
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">@Loc.T("not_provided")</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge @StatusBadgeClass(a.Status)">@a.Status</span>
                                                    </td>
                                                    <td>
                                                        @if (a.Status == "Pending")
                                                        {
                                                            <button class="btn btn-sm btn-outline-success me-1 rounded-pill" @onclick="() => UpdateStatus(a, StatusAccepted)">@Loc.T("accept")</button>
                                                            <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="() => UpdateStatus(a, StatusRejected)">@Loc.T("reject")</button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-outline-secondary rounded-pill" @onclick="() => UpdateStatus(a, StatusPending)">@Loc.T("reset_status")</button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private bool authorized = false;
    private bool loading = true;
    private bool loadingApplicants = false;
    private string? errorMessage;
    private int? expandedJobId;

    private EmployerDashboardStatsDto? stats;
    private List<JobItem> jobs = new();
    private List<ApplicationItem> applicants = new();

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await Loc.InitializeAsync();
        Loc.OnChange += StateHasChanged;

        if (!AuthState.IsLoggedIn)
        {
            Navigation.NavigateTo("login");
            return;
        }

        if (!AuthState.CanAccess("Employer"))
        {
            Navigation.NavigateTo("");
            return;
        }

        authorized = true;
        await LoadStats();
        await LoadJobs();
    }

    private async Task LoadStats()
    {
        try
        {
            stats = await Http.GetFromJsonAsync<EmployerDashboardStatsDto>($"api/employer/stats/{AuthState.UserId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Stats loading error: {ex.Message}");
        }
    }

    private async Task LoadJobs()
    {
        loading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<JobItem>>($"api/jobs/mine/{AuthState.UserId}");
            if (result is not null) jobs = result;
        }
        catch (Exception)
        {
            errorMessage = Loc.T("err_load_jobs");
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ToggleApplicants(int jobId)
    {
        if (expandedJobId == jobId)
        {
            expandedJobId = null;
            return;
        }

        expandedJobId = jobId;
        loadingApplicants = true;
        applicants = new();

        try
        {
            var result = await Http.GetFromJsonAsync<List<ApplicationItem>>($"api/applications/job/{jobId}");
            if (result is not null) applicants = result;
        }
        catch (Exception)
        {

        }
        finally
        {
            loadingApplicants = false;
        }
    }

    private async Task ToggleJobStatus(JobItem job)
    {
        errorMessage = null;
        try
        {
            var newActiveStatus = !job.IsActive;

            var response = await Http.PutAsJsonAsync($"api/jobs/{job.Id}/status", new
            {
                requestingUserId = AuthState.UserId,
                isActive = newActiveStatus
            });

            if (response.IsSuccessStatusCode)
            {
                job.IsActive = newActiveStatus;
                await LoadStats();
            }
            else
            {
                errorMessage = Loc.T("err_update_job_status");
            }
        }
        catch (Exception)
        {
            errorMessage = Loc.T("err_server_unreachable");
        }
    }

    private async Task DeleteJob(int jobId)
    {
        errorMessage = null;
        try
        {
            var response = await Http.DeleteAsync($"api/jobs/{jobId}?requestingUserId={AuthState.UserId}");
            if (response.IsSuccessStatusCode)
            {
                jobs.RemoveAll(j => j.Id == jobId);
                if (expandedJobId == jobId) expandedJobId = null;
                await LoadStats();
            }
            else
            {
                errorMessage = Loc.T("err_delete_job");
            }
        }
        catch (Exception)
        {
            errorMessage = Loc.T("err_server_unreachable");
        }
    }

    private class JobItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Company { get; set; } = "";
        public string Location { get; set; } = "";
        public string JobType { get; set; } = "";
        public bool IsActive { get; set; } = true;
        public bool IsFlagged { get; set; } = false;
        public string Status { get; set; } = "Pending";
        public string? RejectionReason { get; set; }
        public DateTime PostedAt { get; set; }
    }

    private const string StatusPending = "Pending";
    private const string StatusAccepted = "Accepted";
    private const string StatusRejected = "Rejected";

    private async Task UpdateStatus(ApplicationItem application, string newStatus)
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/applications/{application.Id}/status", new
            {
                requestingUserId = AuthState.UserId,
                status = newStatus
            });

            if (response.IsSuccessStatusCode)
            {
                application.Status = newStatus;
            }
            else
            {
                errorMessage = Loc.T("err_update_app_status");
            }
        }
        catch (Exception)
        {
            errorMessage = Loc.T("err_server_unreachable");
        }
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Accepted" => "bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill",
        "Rejected" => "bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill",
        _ => "bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill"
    };

    public class EmployerDashboardStatsDto
    {
        public int TotalJobs { get; set; }
        public int TotalApplicants { get; set; }
        public int ActiveJobs { get; set; }
        public int ClosedJobs { get; set; }
    }

    private class ApplicationItem
    {
        public int Id { get; set; }
        public int JobId { get; set; }
        public string JobTitle { get; set; } = "";
        public string ApplicantName { get; set; } = "";
        public string ApplicantEmail { get; set; } = "";
        public DateTime AppliedAt { get; set; }
        public string Status { get; set; } = "Pending";
        public string? ResumeOriginalFileName { get; set; }
        public string? ResumeUrl { get; set; }
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }
}