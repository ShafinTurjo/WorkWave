@page "/employer"
@using System.Net.Http.Json
@using Frontend.Services
@inject HttpClient Http
@inject AuthStateService AuthState
@inject NavigationManager Navigation

<div class="container mt-4 mb-5">
    @if (!authorized)
    {
        <div class="alert alert-warning">Checking access...</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">Employer Dashboard</h3>
                <p class="text-muted mb-0">Welcome back, @AuthState.FullName</p>
            </div>
            <a href="post-job" class="btn btn-primary px-4 rounded-pill fw-semibold">
                <i class="bi bi-plus-circle me-1"></i> Post a New Job
            </a>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 small mb-4">@errorMessage</div>
        }

        <!-- Top Metrics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small fw-medium">Total Jobs</span>
                    <h3 class="fw-bold text-primary mt-2 mb-0">@(stats?.TotalJobs ?? 0)</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small fw-medium">Total Applicants</span>
                    <h3 class="fw-bold text-success mt-2 mb-0">@(stats?.TotalApplicants ?? 0)</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small fw-medium">Active Listings</span>
                    <h3 class="fw-bold text-warning mt-2 mb-0">@(stats?.ActiveJobs ?? 0)</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                    <span class="text-muted small fw-medium">Closed Listings</span>
                    <h3 class="fw-bold text-secondary mt-2 mb-0">@(stats?.ClosedJobs ?? 0)</h3>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white fw-bold py-3 border-0">My Posted Jobs</div>
            <div class="card-body p-4">
                @if (loading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                }
                else if (jobs.Count == 0)
                {
                    <p class="text-muted mb-0">You haven't posted any jobs yet.</p>
                }
                else
                {
                    @foreach (var job in jobs)
                    {
                        <div class="border rounded-4 p-3 mb-3 bg-white shadow-sm">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h5 class="fw-bold mb-1">@job.Title</h5>
                                    <p class="text-muted small mb-1">@job.Company · @job.Location · @job.JobType</p>
                                    <p class="text-muted small mb-0">Posted @job.PostedAt.ToLocalTime().ToString("dd MMM yyyy")</p>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="() => ToggleApplicants(job.Id)">
                                        @(expandedJobId == job.Id ? "Hide Applicants" : "View Applicants")
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => DeleteJob(job.Id)">
                                        Delete
                                    </button>
                                </div>
                            </div>

                            @if (expandedJobId == job.Id)
                            {
                                <hr />
                                @if (loadingApplicants)
                                {
                                    <p class="text-muted small mb-0">Loading applicants...</p>
                                }
                                else if (applicants.Count == 0)
                                {
                                    <p class="text-muted small mb-0">No applicants yet.</p>
                                }
                                else
                                {
                                    <table class="table table-sm mb-0 align-middle mt-2">
                                        <thead>
                                            <tr><th>Name</th><th>Email</th><th>Applied</th><th>Resume</th><th>Status</th><th>Action</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var a in applicants)
                                            {
                                                <tr>
                                                    <td>@a.ApplicantName</td>
                                                    <td>@a.ApplicantEmail</td>
                                                    <td>@a.AppliedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                                    <td>
                                                        @if (!string.IsNullOrEmpty(a.ResumeUrl))
                                                        {
                                                            <a class="btn btn-sm btn-outline-primary rounded-pill px-2" href="@a.ResumeUrl" target="_blank" rel="noopener">
                                                                <i class="bi bi-file-earmark-pdf-fill me-1"></i>View CV
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted small">Not provided</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <span class="badge @StatusBadgeClass(a.Status)">@a.Status</span>
                                                    </td>
                                                    <td>
                                                        @if (a.Status == "Pending")
                                                        {
                                                            <button class="btn btn-sm btn-outline-success me-1 rounded-pill" @onclick="() => UpdateStatus(a, StatusAccepted)">Accept</button>
                                                            <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="() => UpdateStatus(a, StatusRejected)">Reject</button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-outline-secondary rounded-pill" @onclick="() => UpdateStatus(a, StatusPending)">Reset</button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private bool authorized = false;
    private bool loading = true;
    private bool loadingApplicants = false;
    private string? errorMessage;
    private int? expandedJobId;
    
    private EmployerDashboardStatsDto? stats;
    private List<JobItem> jobs = new();
    private List<ApplicationItem> applicants = new();

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        if (!AuthState.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!AuthState.CanAccess("Employer"))
        {
            Navigation.NavigateTo("/");
            return;
        }

        authorized = true;
        await LoadStats();
        await LoadJobs();
    }

    private async Task LoadStats()
    {
        try
        {
            stats = await Http.GetFromJsonAsync<EmployerDashboardStatsDto>($"api/employer/stats/{AuthState.UserId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Stats loading error: {ex.Message}");
        }
    }

    private async Task LoadJobs()
    {
        loading = true;
        try
        {
            var result = await Http.GetFromJsonAsync<List<JobItem>>($"api/jobs/mine/{AuthState.UserId}");
            if (result is not null) jobs = result;
        }
        catch (Exception)
        {
            errorMessage = "Could not load your jobs.";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ToggleApplicants(int jobId)
    {
        if (expandedJobId == jobId)
        {
            expandedJobId = null;
            return;
        }

        expandedJobId = jobId;
        loadingApplicants = true;
        applicants = new();

        try
        {
            var result = await Http.GetFromJsonAsync<List<ApplicationItem>>($"api/applications/job/{jobId}");
            if (result is not null) applicants = result;
        }
        catch (Exception)
        {
            // Leave empty
        }
        finally
        {
            loadingApplicants = false;
        }
    }

    private async Task DeleteJob(int jobId)
    {
        errorMessage = null;
        try
        {
            var response = await Http.DeleteAsync($"api/jobs/{jobId}?requestingUserId={AuthState.UserId}");
            if (response.IsSuccessStatusCode)
            {
                jobs.RemoveAll(j => j.Id == jobId);
                if (expandedJobId == jobId) expandedJobId = null;
                await LoadStats();
            }
            else
            {
                errorMessage = "Could not delete this job.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Could not reach the server. Please try again.";
        }
    }

    private class JobItem
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Company { get; set; } = "";
        public string Location { get; set; } = "";
        public string JobType { get; set; } = "";
        public DateTime PostedAt { get; set; }
    }

    private const string StatusPending = "Pending";
    private const string StatusAccepted = "Accepted";
    private const string StatusRejected = "Rejected";

    private async Task UpdateStatus(ApplicationItem application, string newStatus)
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/applications/{application.Id}/status", new
            {
                requestingUserId = AuthState.UserId,
                status = newStatus
            });

            if (response.IsSuccessStatusCode)
            {
                application.Status = newStatus;
            }
            else
            {
                errorMessage = "Could not update the application status.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Could not reach the server. Please try again.";
        }
    }

    private static string StatusBadgeClass(string status) => status switch
    {
        "Accepted" => "bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill",
        "Rejected" => "bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill",
        _ => "bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill"
    };

    public class EmployerDashboardStatsDto
    {
        public int TotalJobs { get; set; }
        public int TotalApplicants { get; set; }
        public int ActiveJobs { get; set; }
        public int ClosedJobs { get; set; }
    }

    private class ApplicationItem
    {
        public int Id { get; set; }
        public int JobId { get; set; }
        public string JobTitle { get; set; } = "";
        public string ApplicantName { get; set; } = "";
        public string ApplicantEmail { get; set; } = "";
        public DateTime AppliedAt { get; set; }
        public string Status { get; set; } = "Pending";
        public string? ResumeOriginalFileName { get; set; }
        public string? ResumeUrl { get; set; }
    }
}