@page "/reset-password"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card border-0 shadow p-4 rounded">
            @if (isDone)
            {
                <div class="text-center">
                    <div class="text-success mb-3"><i class="bi bi-check-circle-fill" style="font-size: 3rem;"></i></div>
                    <h4 class="fw-bold mb-2">Password Reset!</h4>
                    <p class="text-muted">@message</p>
                    <a href="login" class="btn btn-primary fw-bold px-4 mt-2">Go to Login</a>
                </div>
            }
            else if (!hasValidLink)
            {
                <div class="text-center">
                    <div class="text-danger mb-3"><i class="bi bi-x-circle-fill" style="font-size: 3rem;"></i></div>
                    <h4 class="fw-bold mb-2">Invalid Link</h4>
                    <p class="text-muted">This reset link is missing required information.</p>
                    <a href="forgot-password" class="btn btn-outline-primary fw-bold px-4 mt-2">Request a new link</a>
                </div>
            }
            else
            {
                <div class="text-center mb-4">
                    <h3 class="fw-bold text-primary">Reset Password</h3>
                    <p class="text-muted small">Choose a new password for @email</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2 small">
                        @errorMessage
                        <div class="mt-2">
                            <a href="forgot-password" class="btn btn-sm btn-outline-danger">Request a new link</a>
                        </div>
                    </div>
                }

                <EditForm Model="@model" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label fw-bold">New password</label>
                        <InputText @bind-Value="model.NewPassword" type="password" class="form-control" />
                        <ValidationMessage For="@(() => model.NewPassword)" class="text-danger small" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Confirm new password</label>
                        <InputText @bind-Value="model.ConfirmPassword" type="password" class="form-control" />
                        <ValidationMessage For="@(() => model.ConfirmPassword)" class="text-danger small" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2" disabled="@isSubmitting">
                        @(isSubmitting ? "Saving..." : "Reset password")
                    </button>
                </EditForm>
            }
        </div>
    </div>
</div>

@code {
    private ResetModel model = new ResetModel();
    private string email = "";
    private string token = "";
    private bool hasValidLink = false;
    private bool isSubmitting = false;
    private bool isDone = false;
    private string message = "";
    private string? errorMessage;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParams = ParseQueryString(uri.Query);

        queryParams.TryGetValue("email", out var emailValue);
        queryParams.TryGetValue("token", out var tokenValue);

        email = emailValue ?? "";
        token = tokenValue ?? "";
        hasValidLink = !string.IsNullOrWhiteSpace(email) && !string.IsNullOrWhiteSpace(token);
    }

    private async Task HandleSubmit()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/password/reset", new
            {
                email = email,
                token = token,
                newPassword = model.NewPassword
            });

            if (response.IsSuccessStatusCode)
            {
                message = "Your password has been reset. You can now log in with your new password.";
                isDone = true;
            }
            else
            {
                errorMessage = "This reset link is invalid or has expired.";
                try
                {
                    var result = await response.Content.ReadFromJsonAsync<ResetResult>();
                    if (!string.IsNullOrWhiteSpace(result?.Message))
                    {
                        errorMessage = result!.Message;
                    }
                }
                catch (Exception)
                {
                    // Body wasn't the expected JSON — keep the generic message above.
                }
            }
        }
        catch (Exception)
        {
            errorMessage = "Could not reach the server. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static Dictionary<string, string> ParseQueryString(string query)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrEmpty(query)) return result;

        var trimmed = query.TrimStart('?');
        foreach (var pair in trimmed.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            var key = Uri.UnescapeDataString(parts[0]);
            var value = parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "";
            result[key] = value;
        }
        return result;
    }

    public class ResetModel
    {
        [Required(ErrorMessage = "Password is required.")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Please confirm your password.")]
        [Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }

    private class ResetResult
    {
        public string Message { get; set; } = "";
    }
}
