@page "/"
<PageTitle>WorkWave - Find & Post Jobs</PageTitle>

<div class="bg-primary text-white text-center py-5 rounded-3 mb-5 shadow-sm">
    <div class="container py-3">
        <h1 class="display-4 fw-bold">Find the Perfect Job or Hire Top Talent</h1>
        <p class="lead mt-3 mb-4 opacity-75">Connect with opportunities, showcase your skills, and streamline your workflow with WorkWave.</p>
        <div class="d-flex justify-content-center gap-3">
            <a href="browse-jobs" class="btn btn-light btn-lg fw-semibold px-4">Browse Jobs</a>
            <a href="post-job" class="btn btn-outline-light btn-lg fw-semibold px-4">Post a Job</a>
        </div>
    </div>
</div>

<div class="row g-4 text-center mb-5">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4">
            <div class="card-body">
                <i class="bi bi-search text-primary display-5 mb-3"></i>
                <h5 class="card-title fw-bold">Smart Job Search</h5>
                <p class="card-text text-muted">Easily filter and find projects tailored to your specific skillset and interests.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4">
            <div class="card-body">
                <i class="bi bi-file-earmark-text text-primary display-5 mb-3"></i>
                <h5 class="card-title fw-bold">Easy Applications</h5>
                <p class="card-text text-muted">Apply to jobs in seconds with your customized profile and track status instantly.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4">
            <div class="card-body">
                <i class="bi bi-shield-check text-primary display-5 mb-3"></i>
                <h5 class="card-title fw-bold">Verified Projects</h5>
                <p class="card-text text-muted">Post and collaborate on authentic projects with complete confidence and security.</p>
            </div>
        </div>
    </div>
</div>

<div class="bg-dark text-white p-5 rounded-3 text-center shadow-sm">
    <h2 class="fw-bold mb-3">Ready to get started?</h2>
    <p class="text-muted mb-4">Create an account today to start posting or applying for jobs.</p>
    <a href="register" class="btn btn-primary btn-lg px-4">Create Account</a>
</div>