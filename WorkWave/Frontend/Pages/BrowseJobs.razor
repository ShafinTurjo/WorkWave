@page "/browse-jobs"
@using System.Net.Http.Json
@inject HttpClient Http
@implements IDisposable

<div class="bg-light-subtle min-vh-100 py-5">
    <div class="container">

        <!-- Premium Hero Section -->
        <div class="text-center mb-5 py-4 px-3 rounded-4 hero-banner">
            <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill mb-3">
                <i class="bi bi-briefcase-fill me-1"></i> @AllJobs.Count @Loc.T("jobs_active_openings")
            </span>
            <h1 class="fw-extrabold text-dark display-5 mb-3">@Loc.T("jobs_hero_title")</h1>
            <p class="text-secondary fs-6 col-lg-8 mx-auto">@Loc.T("jobs_hero_subtitle")</p>
        </div>

        <!-- Modern Search & Filter Bar -->
        <div class="card border-0 shadow-sm p-3 mb-5 rounded-4 bg-white">
            <div class="row g-2 align-items-center mb-2">
                <div class="col-12">
                    <div class="input-group search-input-group">
                        <span class="input-group-text bg-white border-0 text-muted ps-3"><i class="bi bi-search text-primary"></i></span>
                        <input type="text" class="form-control border-0 bg-white py-2 shadow-none" placeholder="@Loc.T("jobs_search_placeholder")" @bind="searchQuery" @bind:event="oninput" />
                    </div>
                </div>
            </div>
            <div class="row g-2 align-items-center">
                <div class="col-lg-3 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-0 text-muted ps-3"><i class="bi bi-grid text-primary"></i></span>
                        <select class="form-select border-0 bg-white py-2 shadow-none cursor-pointer" @bind="selectedCategory" @bind:event="onchange">
                            <option value="">@Loc.T("jobs_all_categories")</option>
                            <option value="IT & Software">@Loc.T("cat_it_software")</option>
                            <option value="Customer Support">@Loc.T("cat_customer_support")</option>
                            <option value="Sales & Marketing">@Loc.T("cat_sales_marketing")</option>
                            <option value="Office Admin">@Loc.T("cat_office_admin")</option>
                            <option value="Delivery & Logistics">@Loc.T("cat_delivery_logistics")</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-0 text-muted ps-3"><i class="bi bi-geo-alt text-primary"></i></span>
                        <select class="form-select border-0 bg-white py-2 shadow-none cursor-pointer" @bind="selectedLocation" @bind:event="onchange">
                            <option value="">@Loc.T("jobs_all_locations")</option>
                            @foreach (var location in AvailableLocations)
                            {
                                <option value="@location">@location</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-0 text-muted ps-3"><i class="bi bi-briefcase text-primary"></i></span>
                        <select class="form-select border-0 bg-white py-2 shadow-none cursor-pointer" @bind="selectedJobType" @bind:event="onchange">
                            <option value="">@Loc.T("jobs_all_types")</option>
                            <option value="Full-Time">@Loc.T("type_fulltime")</option>
                            <option value="Part-Time">@Loc.T("type_parttime")</option>
                            <option value="Contract">@Loc.T("type_contract")</option>
                            <option value="Internship">@Loc.T("type_internship")</option>
                        </select>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6">
                    <button class="btn btn-outline-secondary w-100 fw-bold py-2 shadow-sm rounded-3" @onclick="ClearFilters">
                        <i class="bi bi-x-circle me-1"></i> @Loc.T("btn_clear_filters")
                    </button>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-3">@Loc.T("msg_loading_jobs")</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger text-center">@errorMessage</div>
        }
        else
        {
            <!-- Job Cards Grid -->
            <div class="row g-4">
                @if (FilteredJobs.Any())
                {
                    @foreach (var job in FilteredJobs)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border-0 shadow-sm rounded-4 p-4 job-card bg-white position-relative">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill mb-2">@job.Category</span>
                                        <h5 class="fw-bold text-dark mb-1">
                                            <a href="@($"job/{job.Id}")" class="text-decoration-none text-dark">@job.Title</a>
                                        </h5>
                                        <p class="text-muted small mb-0"><i class="bi bi-building me-1 text-secondary"></i>@job.Company</p>
                                    </div>
                                </div>

                                <p class="text-secondary small line-clamp-2 my-3">@job.Description</p>

                                <div class="d-flex flex-wrap gap-1 mb-3">
                                    @foreach (var tag in job.Tags)
                                    {
                                        <span class="badge bg-light text-dark border px-2 py-1 rounded-2 fw-normal fs-xs">@tag</span>
                                    }
                                </div>

                                <hr class="text-muted opacity-10 my-3" />

                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="text-muted small"><i class="bi bi-geo-alt-fill me-1 text-danger opacity-75"></i>@job.Location</span>
                                    <span class="fw-bold text-success">@job.Salary</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center pt-2">
                                    <span class="badge bg-light text-secondary border fw-medium px-2 py-1">@job.JobType</span>
                                    <button class="btn btn-primary btn-sm fw-bold px-3 py-2 rounded-3 shadow-sm" @onclick="() => selectedJobForApply = job">
                                        @Loc.T("btn_apply") <i class="bi bi-arrow-right ms-1"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm">
                        <i class="bi bi-emoji-frown text-muted display-4"></i>
                        <h5 class="mt-3 text-secondary">@Loc.T("jobs_none_found_title")</h5>
                        <p class="text-muted small">@Loc.T("jobs_none_found_subtitle")</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Reusable Modal Component -->
<ApplyModal SelectedJob="selectedJobForApply"
            OnClose="() => selectedJobForApply = null"
            OnSubmit="() => selectedJobForApply = null" />

<style>
    .bg-light-subtle {
        background-color: #f8fafc !important;
    }

    .hero-banner {
        background: linear-gradient(180deg, #ffffff 0%, #f1f5f9 100%);
        border: 1px solid #e2e8f0;
    }

    .job-card {
        transition: all 0.25s ease-in-out;
        border-top: 3px solid transparent !important;
    }

        .job-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(0,0,0,0.06) !important;
            border-top: 3px solid #0d6efd !important;
        }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .bg-primary-subtle {
        background-color: #e0f2fe !important;
        color: #0284c7 !important;
    }

    .fs-xs {
        font-size: 0.75rem;
    }

    .fw-extrabold {
        font-weight: 800;
    }

    .cursor-pointer {
        cursor: pointer;
    }
</style>

@code {
    private string searchQuery = "";
    private string selectedCategory = "";
    private string selectedLocation = "";
    private string selectedJobType = "";
    private JobModel? selectedJobForApply = null;
    private bool isLoading = true;
    private string? errorMessage;

    private List<JobModel> AllJobs = new();

    private IEnumerable<string> AvailableLocations => AllJobs
        .Select(j => j.Location)
        .Where(l => !string.IsNullOrWhiteSpace(l))
        .Distinct()
        .OrderBy(l => l);

    private IEnumerable<JobModel> FilteredJobs => AllJobs
        .Where(j => string.IsNullOrWhiteSpace(searchQuery) ||
                    j.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    j.Company.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    j.Tags.Any(t => t.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
        .Where(j => string.IsNullOrWhiteSpace(selectedCategory) || j.Category == selectedCategory)
        .Where(j => string.IsNullOrWhiteSpace(selectedLocation) || j.Location == selectedLocation)
        .Where(j => string.IsNullOrWhiteSpace(selectedJobType) || j.JobType == selectedJobType);

    protected override async Task OnInitializedAsync()
    {
        Loc.OnChange += StateHasChanged;

        try
        {
            var jobs = await Http.GetFromJsonAsync<List<JobModel>>("api/jobs");
            AllJobs = jobs ?? new();
        }
        catch (Exception)
        {
            errorMessage = Loc.T("err_load_jobs_failed");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ClearFilters()
    {
        searchQuery = "";
        selectedCategory = "";
        selectedLocation = "";
        selectedJobType = "";
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }
}