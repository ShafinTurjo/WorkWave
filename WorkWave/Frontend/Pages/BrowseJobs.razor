@page "/browse-jobs"

<div class="container py-4">
    <!-- Hero Header -->
    <div class="text-center mb-5">
        <h2 class="fw-bold text-dark display-6 mb-2">Find Opportunities That Match Your Skills</h2>
        <p class="text-muted fs-6">Explore full-time, part-time, corporate, and local job openings across Bangladesh and remote</p>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm p-4 mb-5 rounded-4 bg-white">
        <div class="row g-3">
            <div class="col-lg-5 col-md-12">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control bg-light border-0 py-2" placeholder="Search by job title, company, or skills..." @bind="searchQuery" @bind:event="oninput" />
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <select class="form-select bg-light border-0 py-2" @bind="selectedCategory">
                    <option value="">All Job Categories</option>
                    <option value="IT & Software">IT & Software</option>
                    <option value="Customer Support">Customer Support</option>
                    <option value="Sales & Marketing">Sales & Marketing</option>
                    <option value="Office Admin">Office Admin & Receptionist</option>
                    <option value="Delivery & Logistics">Delivery & Logistics</option>
                </select>
            </div>
            <div class="col-lg-3 col-md-6">
                <button class="btn btn-primary w-100 fw-bold py-2 shadow-sm">
                    <i class="bi bi-funnel me-1"></i> Search Jobs
                </button>
            </div>
        </div>
    </div>

    <!-- Job Cards Grid -->
    <div class="row g-4">
        @if (FilteredJobs.Any())
        {
            @foreach (var job in FilteredJobs)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 job-card transition-all">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">@job.Category</span>
                                <h5 class="fw-bold text-dark mb-1">@job.Title</h5>
                                <p class="text-muted small mb-0"><i class="bi bi-building me-1"></i>@job.Company</p>
                            </div>
                        </div>

                        <p class="text-secondary small line-clamp-2 my-3">@job.Description</p>

                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var tag in job.Tags)
                            {
                                <span class="badge bg-light text-secondary border-0 px-2 py-1 rounded-2">@tag</span>
                            }
                        </div>

                        <hr class="text-muted opacity-25 my-3" />

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="text-muted small"><i class="bi bi-geo-alt me-1"></i>@job.Location</span>
                            <span class="fw-bold text-success">@job.Salary</span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="badge bg-secondary-subtle text-dark fw-normal px-2 py-1">@job.JobType</span>
                            <button class="btn btn-outline-primary btn-sm fw-bold px-3 py-2 rounded-3" @onclick="() => selectedJobForApply = job">
                                Apply Now <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-emoji-frown display-4 text-muted"></i>
                <h4 class="mt-3 text-muted">No jobs found matching your criteria</h4>
            </div>
        }
    </div>
</div>

<!-- Separate Reusable Apply Modal Component -->
<ApplyModal SelectedJob="selectedJobForApply" 
            OnClose="() => selectedJobForApply = null" 
            OnSubmit="() => selectedJobForApply = null" />

<style>
    .job-card { transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out; }
    .job-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .bg-primary-subtle { background-color: #e7f1ff !important; }
    .bg-secondary-subtle { background-color: #f0f2f5 !important; }
</style>

@code {
    private string searchQuery = "";
    private string selectedCategory = "";
    private JobModel? selectedJobForApply = null;

    private List<JobModel> AllJobs = new List<JobModel>
    {
        new JobModel { Title = "Full Stack C# Developer", Company = "TechSolutions", Location = "Remote", Category = "IT & Software", Salary = "৳80,000 - ৳120,000/mo", Description = "Looking for an experienced Blazor & ASP.NET Core developer to build web apps.", JobType = "Full-Time", Tags = new[] { "C#", "Blazor", "SQL" } },
        new JobModel { Title = "Customer Service Executive", Company = "DigiConnect Ltd", Location = "Dhaka, BD", Category = "Customer Support", Salary = "৳22,000 - ৳30,000/mo", Description = "Handle inbound customer queries via call and chat. Good communication skills required.", JobType = "Full-Time", Tags = new[] { "Communication", "English", "Support" } },
        new JobModel { Title = "Front Desk & Admin Officer", Company = "Apex Group", Location = "Chittagong, BD", Category = "Office Admin", Salary = "৳18,000 - ৳25,000/mo", Description = "Manage visitor reception, office phone calls, and administrative paperwork.", JobType = "Full-Time", Tags = new[] { "MS Office", "Management" } },
        new JobModel { Title = "Delivery Fleet Rider", Company = "QuickExpress", Location = "Dhaka, BD", Category = "Delivery & Logistics", Salary = "৳15,000 - ৳22,000/mo", Description = "Deliver parcel packages across local areas. Must have valid driving license.", JobType = "Full-Time", Tags = new[] { "Motorbike", "Local Delivery" } },
        new JobModel { Title = "Sales Representative", Company = "BrandMart", Location = "Sylhet, BD", Category = "Sales & Marketing", Salary = "৳20,000 + Commission", Description = "Visit retail outlets to promote consumer products and collect product orders.", JobType = "Full-Time", Tags = new[] { "Sales", "Negotiation" } }
    };

    private IEnumerable<JobModel> FilteredJobs => AllJobs
        .Where(j => string.IsNullOrWhiteSpace(searchQuery) || j.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || j.Company.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(j => string.IsNullOrWhiteSpace(selectedCategory) || j.Category == selectedCategory);

    public class JobModel
    {
        public string Title { get; set; } = "";
        public string Company { get; set; } = "";
        public string Location { get; set; } = "";
        public string Category { get; set; } = "";
        public string Salary { get; set; } = "";
        public string Description { get; set; } = "";
        public string JobType { get; set; } = "";
        public string[] Tags { get; set; } = Array.Empty<string>();
    }
}