@page "/register"
@using System.Net.Http.Json
@using Frontend.Services
@inject HttpClient Http
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow p-4 rounded">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-primary">@Loc.T("register_title")</h3>
                <p class="text-muted small">@Loc.T("register_subtitle")</p>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 small">@errorMessage</div>
            }

            <EditForm Model="@registerModel" OnValidSubmit="HandleRegistration">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label fw-bold">@Loc.T("lbl_i_want_to")</label>
                     <InputSelect @bind-Value="registerModel.Role" class="form-select">
                        <option value="Worker">@Loc.T("role_worker")</option>
                        <option value="Employer">@Loc.T("role_employer")</option>
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@Loc.T("lbl_full_name")</label>
                    <InputText @bind-Value="registerModel.FullName" class="form-control" />
                    <ValidationMessage For="@(() => registerModel.FullName)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@Loc.T("lbl_email")</label>
                    <InputText @bind-Value="registerModel.Email" class="form-control" />
                    <ValidationMessage For="@(() => registerModel.Email)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@Loc.T("lbl_password")</label>
                    <InputText @bind-Value="registerModel.Password" type="password" class="form-control" />
                    <ValidationMessage For="@(() => registerModel.Password)" class="text-danger small" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold">@Loc.T("lbl_confirm_password")</label>
                    <InputText @bind-Value="registerModel.ConfirmPassword" type="password" class="form-control" />
                    <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="text-danger small" />
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold py-2" disabled="@isSubmitting">
                    @(isSubmitting ? Loc.T("btn_creating_account") : Loc.T("btn_register"))
                </button>
            </EditForm>

            <div class="text-center mt-4">
                <span class="text-muted small">@Loc.T("msg_have_account") </span>
                <a href="login" class="text-primary fw-bold text-decoration-none small">@Loc.T("link_login_here")</a>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterModel registerModel = new RegisterModel();
    private string? errorMessage;
    private bool isSubmitting = false;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    private async Task HandleRegistration()
    {
        errorMessage = null;

        if (registerModel.Password != registerModel.ConfirmPassword)
        {
            errorMessage = Loc.T("err_passwords_mismatch");
            return;
        }

        isSubmitting = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/register", new
            {
                fullName = registerModel.FullName,
                email = registerModel.Email,
                password = registerModel.Password,
                role = registerModel.Role
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RegisterResult>();
                if (result is not null)
                {
                    await AuthState.SetUserAsync(result.UserId, result.FullName, result.Email, result.Role);
                    var destination = result.Role == "Employer" ? "/employer" : "/worker";
                    Navigation.NavigateTo(destination);
                }
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                errorMessage = Loc.T("err_email_exists");
            }
            else
            {
                errorMessage = Loc.T("err_registration_failed");
            }
        }
        catch (Exception)
        {
            errorMessage = Loc.T("err_server_unreachable");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }

    public class RegisterModel
    {
        public string Role { get; set; } = "Worker";
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }

    private class RegisterResult
    {
        public int UserId { get; set; }
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
    }
}