@page "/register"
@using System.Net.Http.Json
@using Frontend.Services
@inject HttpClient Http
@inject AuthStateService AuthState
@inject NavigationManager Navigation
@implements IDisposable

<div class="auth-page" style="background-image: linear-gradient(135deg, rgba(15,23,42,0.75), rgba(15,23,42,0.55)), url('/images/auth-bg.jpg'); background-size: cover; background-position: center;">
    <div class="glass-card p-4 p-md-5" style="max-width: 460px; width: 100%;">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-white">@Loc.T("register_title")</h3>
            <p class="text-white-50 small">@Loc.T("register_subtitle")</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 small">@errorMessage</div>
        }

        @if (registeredEmail is not null)
        {
            <div class="alert alert-success">
                <strong>Almost done!</strong> We've sent a verification link to <strong>@registeredEmail</strong>.
                Please check your inbox (and spam folder) and click the link before logging in.
            </div>
            <div class="text-center mt-3">
                <a href="login" class="btn btn-primary fw-bold px-4 hover-lift">Go to Login</a>
            </div>
        }
        else
        {
            <EditForm Model="@registerModel" OnValidSubmit="HandleRegistration">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label fw-semibold text-white">@Loc.T("lbl_i_want_to")</label>
                    <InputSelect @bind-Value="registerModel.Role" class="form-select glass-input">
                        <option value="Worker" style="color:#111;">@Loc.T("role_worker")</option>
                        <option value="Employer" style="color:#111;">@Loc.T("role_employer")</option>
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-white">@Loc.T("lbl_full_name")</label>
                    <InputText @bind-Value="registerModel.FullName" class="form-control glass-input" />
                    <ValidationMessage For="@(() => registerModel.FullName)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-white">@Loc.T("lbl_email")</label>
                    <InputText @bind-Value="registerModel.Email" class="form-control glass-input" />
                    <ValidationMessage For="@(() => registerModel.Email)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-white">@Loc.T("lbl_password")</label>
                    <InputText @bind-Value="registerModel.Password" type="password" class="form-control glass-input" />
                    <ValidationMessage For="@(() => registerModel.Password)" class="text-danger small" />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold text-white">@Loc.T("lbl_confirm_password")</label>
                    <InputText @bind-Value="registerModel.ConfirmPassword" type="password" class="form-control glass-input" />
                    <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="text-danger small" />
                </div>

                <button type="submit" class="btn btn-primary w-100 fw-bold py-2 hover-lift" disabled="@isSubmitting">
                    @(isSubmitting ? Loc.T("btn_creating_account") : Loc.T("btn_register"))
                </button>
            </EditForm>
        }

        <div class="text-center mt-4">
            <span class="text-white-50 small">@Loc.T("msg_have_account") </span>
            <a href="login" class="text-white fw-bold text-decoration-none small">@Loc.T("link_login_here")</a>
        </div>
    </div>
</div>
@code {
    private RegisterModel registerModel = new RegisterModel();
    private string? errorMessage;
    private string? registeredEmail;
    private bool isSubmitting = false;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
    }

    private async Task HandleRegistration()
    {
        errorMessage = null;

        if (registerModel.Password != registerModel.ConfirmPassword)
        {
            errorMessage = Loc.T("err_passwords_mismatch");
            return;
        }

        isSubmitting = true;

        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/register", new
            {
                fullName = registerModel.FullName,
                email = registerModel.Email,
                password = registerModel.Password,
                role = registerModel.Role
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<RegisterResult>();
                registeredEmail = result?.Email ?? registerModel.Email;
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                errorMessage = Loc.T("err_email_exists");
            }
            else
            {
                errorMessage = Loc.T("err_registration_failed");
            }
        }
        catch (Exception)
        {
            errorMessage = Loc.T("err_server_unreachable");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }

    public class RegisterModel
    {
        public string Role { get; set; } = "Worker";
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }

    private class RegisterResult
    {
        public string Email { get; set; } = "";
        public string Message { get; set; } = "";
    }
}