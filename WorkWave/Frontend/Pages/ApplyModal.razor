@using System.Net.Http.Json
@using Frontend.Services
@inject HttpClient Http
@inject AuthStateService AuthState
@implements IDisposable

@if (SelectedJob != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.55); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 rounded-4 p-3 shadow-lg">
                <div class="modal-header border-0 pb-1">
                    <div>
                        <h4 class="modal-title fw-bold text-dark tracking-tight">@Loc.T("apply_for_prefix") @SelectedJob.Title</h4>
                        <p class="text-muted small mb-0">@Loc.T("company_label") <span class="fw-semibold text-primary">@SelectedJob.Company</span></p>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body py-3">
                    @if (!AuthState.IsLoggedIn)
                    {
                        <div class="alert alert-warning">@Loc.T("need_login_to_apply") <a href="login">@Loc.T("log_in_lowercase")</a> @Loc.T("as_worker_to_apply")</div>
                    }
                    else if (!AuthState.IsWorker)
                    {
                        <div class="alert alert-info">@Loc.T("only_workers_can_apply")</div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger py-2 small">@errorMessage</div>
                        }
                        <form>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold text-secondary small mb-1">@Loc.T("lbl_full_name")</label>
                                    <input type="text" class="form-control custom-input" @bind="fullName" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold text-secondary small mb-1">@Loc.T("lbl_email")</label>
                                    <input type="email" class="form-control custom-input" @bind="email" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold text-secondary small mb-1">@Loc.T("cover_letter_lbl")</label>
                                    <textarea class="form-control custom-input" rows="4" @bind="coverLetter"></textarea>
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-semibold text-secondary small mb-1">@Loc.T("cv_resume_pdf_lbl")</label>
                                    <InputFile OnChange="OnResumeSelected" accept=".pdf" class="form-control custom-input" />
                                    @if (resumeFile != null)
                                    {
                                        <div class="form-text text-success">
                                            <i class="bi bi-file-earmark-check-fill me-1"></i>@resumeFile.Name (@FormatSize(resumeFile.Size))
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(resumeError))
                                    {
                                        <div class="form-text text-danger">@resumeError</div>
                                    }
                                </div>
                            </div>
                        </form>
                    }
                </div>

                <div class="modal-footer border-0 pt-2">
                    <button type="button" class="btn btn-light fw-bold px-4 py-2 rounded-3 text-secondary" @onclick="CloseModal">@Loc.T("btn_cancel")</button>
                    @if (AuthState.IsWorker)
                    {
                        <button type="button" class="btn btn-primary fw-bold px-4 py-2 rounded-3 shadow-sm" disabled="@isSubmitting" @onclick="SubmitModal">
                            <i class="bi bi-send-fill me-2"></i>@(isSubmitting ? Loc.T("btn_submitting") : Loc.T("submit_application"))
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .custom-input {
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        padding: 0.6rem 0.75rem;
        font-size: 0.95rem;
        color: #1e293b;
        transition: all 0.2s ease-in-out;
    }

        .custom-input:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
            background-color: #fff;
        }

    .tracking-tight {
        letter-spacing: -0.02em;
    }
</style>

@code {
    [Parameter] public JobModel? SelectedJob { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSubmit { get; set; }

    private const long MaxResumeSizeBytes = 5 * 1024 * 1024; // 5 MB

    private string fullName = "";
    private string email = "";
    private string coverLetter = "";
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? resumeFile;
    private string? resumeError;
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        Loc.OnChange += StateHasChanged;
        AuthState.OnChange += StateHasChanged;
    }

    protected override void OnParametersSet()
    {
        if (SelectedJob != null)
        {
            fullName = AuthState.FullName ?? "";
            email = AuthState.Email ?? "";
            coverLetter = "";
            resumeFile = null;
            resumeError = null;
            errorMessage = null;
        }
    }

    private void OnResumeSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var file = e.File;
        resumeError = null;
        resumeFile = null;

        if (file.ContentType != "application/pdf" && !file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
        {
            resumeError = Loc.T("resume_pdf_only_err");
            return;
        }

        if (file.Size > MaxResumeSizeBytes)
        {
            resumeError = Loc.T("resume_too_large_err");
            return;
        }

        resumeFile = file;
    }

    private static string FormatSize(long bytes) => bytes < 1024 * 1024
        ? $"{bytes / 1024.0:0.#} KB"
        : $"{bytes / (1024.0 * 1024.0):0.#} MB";

    private async Task CloseModal() => await OnClose.InvokeAsync();

    private async Task SubmitModal()
    {
        if (SelectedJob is null || AuthState.UserId is null || !AuthState.IsWorker) return;

        if (string.IsNullOrWhiteSpace(fullName) || string.IsNullOrWhiteSpace(email))
        {
            errorMessage = Loc.T("err_fill_name_email");
            return;
        }

        errorMessage = null;
        isSubmitting = true;

        try
        {
            using var content = new MultipartFormDataContent
            {
                { new StringContent(SelectedJob.Id.ToString()), "JobId" },
                { new StringContent(AuthState.UserId.Value.ToString()), "ApplicantUserId" },
                { new StringContent(fullName), "ApplicantName" },
                { new StringContent(email), "ApplicantEmail" },
                { new StringContent(coverLetter ?? ""), "CoverLetter" }
            };

            if (resumeFile != null)
            {
                var streamContent = new StreamContent(resumeFile.OpenReadStream(MaxResumeSizeBytes));
                streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("application/pdf");
                content.Add(streamContent, "Resume", resumeFile.Name);
            }

            var response = await Http.PostAsync("api/applications", content);

            if (response.IsSuccessStatusCode)
            {
                await OnSubmit.InvokeAsync();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                errorMessage = Loc.T("err_already_applied");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                errorMessage = Loc.T("only_workers_can_apply");
            }
            else
            {
                errorMessage = Loc.T("err_submit_application_failed");
            }
        }
        catch (Exception)
        {
            errorMessage = Loc.T("err_server_unreachable");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
        AuthState.OnChange -= StateHasChanged;
    }
}
