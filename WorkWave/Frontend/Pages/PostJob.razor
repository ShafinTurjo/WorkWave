@page "/post-job"
@page "/post-a-job"
@using System.Net.Http.Json
@using Frontend.Services
@inject NavigationManager Navigation
@inject HttpClient Http
@inject AuthStateService AuthState
@inject LocalizationService Loc
@implements IDisposable

<div class="bg-light-subtle min-vh-100 py-5">
    <div class="container" style="max-width: 760px;">

        <!-- Header -->
        <div class="text-center mb-4">
            <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill mb-2">
                <i class="bi bi-building-add me-1"></i> @Loc.T("badge_employers_hub")
            </span>
            <h2 class="fw-extrabold text-white display-6">@Loc.T("post_job_title")</h2>
            <p class="text-white-50 fs-6">@Loc.T("post_job_subtitle")</p>
        </div>

        @if (!AuthState.IsLoggedIn)
        {
            <div class="alert alert-warning border-0 shadow-sm rounded-4 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
                <div>
                    <h6 class="fw-bold mb-0">@Loc.T("please_login_first")</h6>
                    <small>@Loc.T("msg_need_account_post") <a href="login">@Loc.T("link_login_here")</a>.</small>
                </div>
            </div>
        }
        else if (!AuthState.CanAccess("Employer"))
        {
            <div class="alert alert-warning border-0 shadow-sm rounded-4 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
                <div>
                    <h6 class="fw-bold mb-0">@Loc.T("employer_accounts_only")</h6>
                    <small>@Loc.T("msg_employer_only") <a href="worker">@Loc.T("link_go_dashboard")</a>.</small>
                </div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger border-0 shadow-sm rounded-4 mb-4">@errorMessage</div>
            }

            <!-- Success Alert -->
            @if (isSubmitted)
            {
                <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center" role="alert">
                    <i class="bi bi-check-circle-fill fs-4 me-3 text-success"></i>
                    <div>
                        <h6 class="fw-bold mb-0">@Loc.T("job_posted_success")</h6>
                        <small>@Loc.T("redirecting_msg")</small>
                    </div>
                </div>
            }

            <!-- Form Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <EditForm Model="newJob" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <!-- Job Title -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small">@Loc.T("lbl_job_title") <span class="text-danger">*</span></label>
                        <input type="text" class="form-control form-control-lg custom-input" @bind-value="newJob.Title" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Company Name -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">@Loc.T("lbl_company_name") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control custom-input" @bind-value="newJob.Company" required />
                        </div>
                        <!-- Category -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">@Loc.T("job_category") <span class="text-danger">*</span></label>
                            <select class="form-select custom-input" @bind="newJob.Category" required>
                                <option value="">@Loc.T("select_category")</option>
                                <option value="IT & Software">IT & Software</option>
                                <option value="Customer Support">Customer Support</option>
                                <option value="Sales & Marketing">Sales & Marketing</option>
                                <option value="Office Admin">Office Admin</option>
                                <option value="Delivery & Logistics">Delivery & Logistics</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Location -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">@Loc.T("lbl_location") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control custom-input" @bind-value="newJob.Location" required />
                        </div>
                        <!-- Salary Range -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">@Loc.T("lbl_salary_range") <span class="text-danger">*</span></label>
                            <input type="text" class="form-control custom-input" @bind-value="newJob.Salary" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <!-- Job Type -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">@Loc.T("lbl_job_type") <span class="text-danger">*</span></label>
                            <select class="form-select custom-input" @bind="newJob.JobType" required>
                                <option value="Full-Time">Full-Time</option>
                                <option value="Part-Time">Part-Time</option>
                                <option value="Contract">Contract</option>
                                <option value="Internship">Internship</option>
                            </select>
                        </div>
                        <!-- Skills / Tags -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold text-dark small">@Loc.T("lbl_key_skills")</label>
                            <input type="text" class="form-control custom-input" placeholder="@Loc.T("skills_placeholder")" @bind-value="tagsInput" />
                        </div>
                    </div>

                    <!-- Description -->
                    <div class="mb-4">
                        <label class="form-label fw-semibold text-dark small">@Loc.T("lbl_job_description") <span class="text-danger">*</span></label>
                        <textarea class="form-control custom-input" rows="5" @bind="newJob.Description" required></textarea>
                    </div>

                    <!-- Submit Button -->
                    <div class="d-flex justify-content-end gap-3 pt-2">
                        <button type="button" class="btn btn-light fw-bold px-4 py-2 rounded-3 border" @onclick='() => Navigation.NavigateTo("browse-jobs")'>@Loc.T("btn_cancel")</button>
                        <button type="submit" class="btn btn-primary fw-bold px-4 py-2 rounded-3 shadow-sm" disabled="@isSubmitting">
                            <i class="bi bi-send-check me-1"></i> @(isSubmitting ? Loc.T("btn_publishing") : Loc.T("btn_publish_job"))
                        </button>
                    </div>
                </EditForm>
            </div>
        }
    </div>
</div>

<style>
    .bg-light-subtle {
        background-color: transparent !important;
    }

    .fw-extrabold {
        font-weight: 800;
    }

    .bg-primary-subtle {
        background-color: #e0f2fe !important;
        color: #0284c7 !important;
    }

    .custom-input {
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 0.6rem 0.85rem;
        font-size: 0.95rem;
        background-color: #ffffff;
        transition: all 0.2s ease-in-out;
    }

        .custom-input:focus {
            border-color: #0284c7;
            box-shadow: 0 0 0 4px rgba(2, 132, 199, 0.1);
            background-color: #ffffff;
        }
</style>

@code {
    private PostJobModel newJob = new PostJobModel();
    private string tagsInput = "";
    private bool isSubmitted = false;
    private bool isSubmitting = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();
        await Loc.InitializeAsync();
        Loc.OnChange += StateHasChanged;
    }

    private async Task HandleSubmit()
    {
        if (!AuthState.IsLoggedIn || AuthState.UserId is null)
        {
            errorMessage = Loc.T("err_must_login_post");
            return;
        }

        errorMessage = null;
        isSubmitting = true;

        try
        {
            var tags = tagsInput
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            var response = await Http.PostAsJsonAsync("api/jobs", new
            {
                title = newJob.Title,
                company = newJob.Company,
                location = newJob.Location,
                category = newJob.Category,
                salary = newJob.Salary,
                description = newJob.Description,
                jobType = newJob.JobType,
                tags = tags,
                postedByUserId = AuthState.UserId.Value
            });

            if (response.IsSuccessStatusCode)
            {
                isSubmitted = true;
                StateHasChanged();
                await Task.Delay(1500);
                Navigation.NavigateTo("browse-jobs");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                errorMessage = await ReadServerMessageAsync(response)
                               ?? Loc.T("err_duplicate_job");
            }
            else
            {
                errorMessage = Loc.T("err_post_job_failed");
            }
        }
        catch (Exception)
        {
            errorMessage = Loc.T("err_server_unreachable");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static async Task<string?> ReadServerMessageAsync(HttpResponseMessage response)
    {
        try
        {
            var body = await response.Content.ReadFromJsonAsync<ServerMessage>();
            return string.IsNullOrWhiteSpace(body?.Message) ? null : body!.Message;
        }
        catch (Exception)
        {
            return null;
        }
    }

    private class ServerMessage
    {
        public string Message { get; set; } = "";
    }

    public class PostJobModel
    {
        public string Title { get; set; } = "";
        public string Company { get; set; } = "";
        public string Category { get; set; } = "";
        public string Location { get; set; } = "";
        public string Salary { get; set; } = "";
        public string JobType { get; set; } = "Full-Time";
        public string Description { get; set; } = "";
    }

    public void Dispose()
    {
        Loc.OnChange -= StateHasChanged;
    }
}