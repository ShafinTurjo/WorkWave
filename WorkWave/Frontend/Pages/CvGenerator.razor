@page "/cv-generator"
@inject HttpClient Http
@inject Frontend.Services.AuthStateService AuthState
@inject IJSRuntime JS

<div class="container mt-4">
    <h3 class="mb-4">Build & Generate Your Resume</h3>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <!-- Form Left Side -->
            <div class="col-md-5 border-end pe-4 mb-4">
                <h5>Enter Details</h5>
                <div class="mb-3">
                    <label class="form-label">Full Name</label>
                    <input class="form-control" @bind="resume.FullName" @bind:event="oninput" placeholder="e.g. TASMIA TABASSUM" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Phone Number</label>
                    <input class="form-control" @bind="resume.Phone" @bind:event="oninput" placeholder="e.g. 01406090772" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Professional Summary</label>
                    <textarea class="form-control" rows="3" @bind="resume.Summary" @bind:event="oninput" placeholder="Brief summary about your goals..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Skills (comma separated)</label>
                    <input class="form-control" @bind="resume.Skills" @bind:event="oninput" placeholder="e.g. HTML, CSS, JavaScript, SQL, .NET" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Experience</label>
                    <textarea class="form-control" rows="4" @bind="resume.Experience" @bind:event="oninput" placeholder="Work experience details..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Education</label>
                    <textarea class="form-control" rows="3" @bind="resume.Education" @bind:event="oninput" placeholder="Degree, Institution name, Graduation year..."></textarea>
                </div>

                <div class="mt-4 mb-3">
                    <button class="btn btn-primary" @onclick="SaveResume" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save to Profile</span>
                        }
                    </button>
                    <button class="btn btn-outline-secondary ms-2" @onclick="TriggerPrint">Download PDF / Print</button>
                </div>
            </div>

            <!-- Modern Shaded Resume Preview Right Side -->
            <div class="col-md-7 ps-4">
                <h5>Live CV Preview</h5>
                <div id="cv-print-area" class="card border-0 shadow-sm overflow-hidden" style="min-height: 700px; font-family: 'Georgia', serif; background-color: #ffffff;">
                    
                    <!-- Dark Header Banner -->
                    <div style="background-color: #4a4a4a; color: #ffffff; padding: 30px 25px; text-transform: uppercase;">
                        <h2 class="m-0 font-weight-bold" style="letter-spacing: 2px; font-size: 26px;">
                            @(string.IsNullOrWhiteSpace(resume.FullName) ? "YOUR NAME" : resume.FullName)
                        </h2>
                    </div>

                    <div class="d-flex" style="min-height: 600px;">
                        <!-- Left Slate Blue Sidebar -->
                        <div style="background-color: #5b707a; color: #ffffff; width: 38%; padding: 25px 18px; font-size: 13px;">
                            <div class="mb-4">
                                <h6 class="text-uppercase fw-bold border-bottom pb-1 mb-3" style="letter-spacing: 1px; font-size: 12px; border-color: rgba(255,255,255,0.3) !important;">Contact</h6>
                                <div class="mb-2 d-flex align-items-center gap-2">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    <span>Dhaka, Bangladesh</span>
                                </div>
                                <div class="mb-2 d-flex align-items-center gap-2">
                                    <i class="bi bi-telephone-fill"></i>
                                    <span>@(string.IsNullOrWhiteSpace(resume.Phone) ? "Phone Number" : resume.Phone)</span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="text-uppercase fw-bold border-bottom pb-1 mb-3" style="letter-spacing: 1px; font-size: 12px; border-color: rgba(255,255,255,0.3) !important;">Skills</h6>
                                <p style="white-space: pre-line; line-height: 1.6;">
                                    @(string.IsNullOrWhiteSpace(resume.Skills) ? "Your listed skills" : resume.Skills)
                                </p>
                            </div>
                        </div>

                        <!-- Right White Main Content -->
                        <div style="width: 62%; padding: 25px 25px; color: #222222; font-size: 13px;">
                            @if (!string.IsNullOrWhiteSpace(resume.Summary))
                            {
                                <div class="mb-4">
                                    <h6 class="text-uppercase fw-bold pb-1 mb-2" style="letter-spacing: 1px; font-size: 13px; border-bottom: 1.5px solid #666;">SUMMARY</h6>
                                    <p style="line-height: 1.5; color: #444;">@resume.Summary</p>
                                </div>
                            }

                            <div class="mb-4">
                                <h6 class="text-uppercase fw-bold pb-1 mb-2" style="letter-spacing: 1px; font-size: 13px; border-bottom: 1.5px solid #666;">EXPERIENCE</h6>
                                <p style="white-space: pre-line; line-height: 1.5; color: #333;">
                                    @(string.IsNullOrWhiteSpace(resume.Experience) ? "Your experience details will appear here." : resume.Experience)
                                </p>
                            </div>

                            <div class="mb-4">
                                <h6 class="text-uppercase fw-bold pb-1 mb-2" style="letter-spacing: 1px; font-size: 13px; border-bottom: 1.5px solid #666;">EDUCATION</h6>
                                <p style="white-space: pre-line; line-height: 1.5; color: #333;">
                                    @(string.IsNullOrWhiteSpace(resume.Education) ? "Your education details will appear here." : resume.Education)
                                </p>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    }
</div>

<style>
    @@media print {
        body * {
            visibility: hidden !important;
        }
        #cv-print-area, #cv-print-area * {
            visibility: visible !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }
        #cv-print-area {
            position: absolute !important;
            left: 0 !important;
            top: 0 !important;
            width: 100% !important;
            margin: 0 !important;
            box-shadow: none !important;
        }
    }
</style>

@code {
    private ResumeDto resume = new();
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        int currentUserId = 0;
        if (AuthState.UserId.HasValue && AuthState.UserId.Value > 0)
        {
            currentUserId = AuthState.UserId.Value;
        }
        else
        {
            var savedId = await JS.InvokeAsync<string?>("localStorage.getItem", "workwave_user_id");
            int.TryParse(savedId, out currentUserId);
        }

        if (currentUserId > 0)
        {
            resume.UserId = currentUserId;

            try
            {
                var response = await Http.GetAsync($"api/resume/{currentUserId}");
                if (response.IsSuccessStatusCode)
                {
                    var fetchedResume = await response.Content.ReadFromJsonAsync<ResumeDto>();
                    if (fetchedResume != null)
                    {
                        resume = fetchedResume;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching resume: {ex.Message}");
            }
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task SaveResume()
    {
        int currentUserId = AuthState.UserId ?? 0;
        if (currentUserId == 0)
        {
            var savedId = await JS.InvokeAsync<string?>("localStorage.getItem", "workwave_user_id");
            int.TryParse(savedId, out currentUserId);
        }

        if (currentUserId > 0)
        {
            isSaving = true;
            resume.UserId = currentUserId;

            var response = await Http.PostAsJsonAsync("api/resume", resume);
            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Resume saved successfully!");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Failed to save resume. Please check backend API.");
            }
            isSaving = false;
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Please log in first as a Worker to save your resume.");
        }
    }

    private async Task TriggerPrint()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    public class ResumeDto
    {
        public int Id { get; set; }
        public int UserId { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Summary { get; set; } = string.Empty;
        public string Experience { get; set; } = string.Empty;
        public string Education { get; set; } = string.Empty;
        public string Skills { get; set; } = string.Empty;
    }
}