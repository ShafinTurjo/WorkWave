@page "/cv-generator"
@inject HttpClient Http
@inject Frontend.Services.AuthStateService AuthState
@inject IJSRuntime JS

<div class="container mt-4">
    <h3 class="mb-4">Build & Generate Your Resume</h3>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-5 border-end pe-4 mb-4">
                <h5 class="fw-bold mb-3">Enter Details</h5>
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Full Name</label>
                    <input class="form-control" @bind="resume.FullName" @bind:event="oninput" placeholder="e.g. TASMIA TABASSUM" />
                </div>
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Phone Number</label>
                    <input class="form-control" @bind="resume.Phone" @bind:event="oninput" placeholder="e.g. 01406090772" />
                </div>
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Professional Summary</label>
                    <textarea class="form-control" rows="3" @bind="resume.Summary" @bind:event="oninput" placeholder="Brief summary about your goals..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Skills (comma separated)</label>
                    <input class="form-control" @bind="resume.Skills" @bind:event="oninput" placeholder="e.g. HTML, CSS, JavaScript, SQL, .NET" />
                </div>
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Experience</label>
                    <textarea class="form-control" rows="4" @bind="resume.Experience" @bind:event="oninput" placeholder="Work experience details..."></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Education</label>
                    <textarea class="form-control" rows="3" @bind="resume.Education" @bind:event="oninput" placeholder="Degree, Institution name, Graduation year..."></textarea>
                </div>

                <div class="mt-4 mb-3 d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveResume" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save to Profile</span>
                        }
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="PrintCv">
                        <i class="bi bi-printer me-1"></i> Download PDF / Print
                    </button>
                </div>
            </div>

            <div class="col-md-7 ps-4 d-flex flex-column align-items-center">
                <h5 class="fw-bold align-self-start mb-3">Live CV Preview</h5>

                <div id="cv-preview-container" class="card border-0 shadow overflow-hidden" style="width: 100%; max-width: 800px; font-family: 'Georgia', serif; background-color: #ffffff;">
                    <div style="background-color: #374151; color: #ffffff; padding: 25px 30px; text-transform: uppercase;">
                        <h1 class="m-0 font-weight-bold" style="letter-spacing: 2px; font-size: 24px;">
                            @(string.IsNullOrWhiteSpace(resume.FullName) ? "YOUR NAME" : resume.FullName)
                        </h1>
                    </div>

                    <div class="d-flex" style="min-height: 680px;">
                        <div style="background-color: #52636d; color: #ffffff; width: 35%; padding: 25px 20px; font-size: 13px;">
                            <div class="mb-4">
                                <h6 class="text-uppercase fw-bold border-bottom pb-2 mb-3" style="letter-spacing: 1px; font-size: 12px; border-color: rgba(255,255,255,0.3) !important;">Contact</h6>
                                <div class="mb-2 d-flex align-items-center gap-2">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    <span>Dhaka, Bangladesh</span>
                                </div>
                                <div class="mb-2 d-flex align-items-center gap-2">
                                    <i class="bi bi-telephone-fill"></i>
                                    <span>@(string.IsNullOrWhiteSpace(resume.Phone) ? "Phone Number" : resume.Phone)</span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="text-uppercase fw-bold border-bottom pb-2 mb-3" style="letter-spacing: 1px; font-size: 12px; border-color: rgba(255,255,255,0.3) !important;">Skills</h6>
                                <p style="white-space: pre-line; line-height: 1.5; word-break: break-word;">
                                    @(string.IsNullOrWhiteSpace(resume.Skills) ? "Your listed skills" : resume.Skills)
                                </p>
                            </div>
                        </div>

                        <div style="width: 65%; padding: 25px 25px; color: #1f2937; font-size: 13px;">
                            @if (!string.IsNullOrWhiteSpace(resume.Summary))
                            {
                                <div class="mb-3">
                                    <h6 class="text-uppercase fw-bold pb-1 mb-2" style="letter-spacing: 1px; font-size: 12px; border-bottom: 2px solid #374151;">SUMMARY</h6>
                                    <p style="line-height: 1.5; color: #374151;">@resume.Summary</p>
                                </div>
                            }

                            <div class="mb-3">
                                <h6 class="text-uppercase fw-bold pb-1 mb-2" style="letter-spacing: 1px; font-size: 12px; border-bottom: 2px solid #374151;">EXPERIENCE</h6>
                                <p style="white-space: pre-line; line-height: 1.5; color: #374151;">
                                    @(string.IsNullOrWhiteSpace(resume.Experience) ? "Your experience details will appear here." : resume.Experience)
                                </p>
                            </div>

                            <div class="mb-3">
                                <h6 class="text-uppercase fw-bold pb-1 mb-2" style="letter-spacing: 1px; font-size: 12px; border-bottom: 2px solid #374151;">EDUCATION</h6>
                                <p style="white-space: pre-line; line-height: 1.5; color: #374151;">
                                    @(string.IsNullOrWhiteSpace(resume.Education) ? "Your education details will appear here." : resume.Education)
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    }
</div>

@code {
    private ResumeDto resume = new();
    private bool isLoading = true;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        int currentUserId = 0;
        if (AuthState.UserId.HasValue && AuthState.UserId.Value > 0)
        {
            currentUserId = AuthState.UserId.Value;
        }
        else
        {
            var savedId = await JS.InvokeAsync<string?>("localStorage.getItem", "workwave_user_id");
            int.TryParse(savedId, out currentUserId);
        }

        if (currentUserId > 0)
        {
            resume.UserId = currentUserId;

            try
            {
                var response = await Http.GetAsync($"api/resume/{currentUserId}");
                if (response.IsSuccessStatusCode)
                {
                    var fetchedResume = await response.Content.ReadFromJsonAsync<ResumeDto>();
                    if (fetchedResume != null)
                    {
                        resume = fetchedResume;
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error fetching resume: {ex.Message}");
            }
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task SaveResume()
    {
        int currentUserId = AuthState.UserId ?? 0;
        if (currentUserId == 0)
        {
            var savedId = await JS.InvokeAsync<string?>("localStorage.getItem", "workwave_user_id");
            int.TryParse(savedId, out currentUserId);
        }

        if (currentUserId > 0)
        {
            isSaving = true;
            resume.UserId = currentUserId;

            var response = await Http.PostAsJsonAsync("api/resume", resume);
            if (response.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("alert", "Resume saved successfully!");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Failed to save resume. Please check backend API.");
            }
            isSaving = false;
        }
        else
        {
            await JS.InvokeVoidAsync("alert", "Please log in first to save your resume.");
        }
    }

    private async Task PrintCv()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    public class ResumeDto
    {
        public int Id { get; set; }
        public int UserId { get; set; }
        public string FullName { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Summary { get; set; } = string.Empty;
        public string Experience { get; set; } = string.Empty;
        public string Education { get; set; } = string.Empty;
        public string Skills { get; set; } = string.Empty;
    }
}